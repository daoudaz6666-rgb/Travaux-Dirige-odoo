<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_library_loan_kanban" model="ir.ui.view">
        <field name="name">library.loan.kanban</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="book_id"/>
                <field name="borrower_id"/>
                <field name="loan_date"/>
                <field name="return_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="book_id"/></strong>
                            <div>
                                Emprunteur: <field name="borrower_id"/>
                            </div>
                            <div>
                                Retour prevu: <field name="return_date"/>
                            </div>
                            <div>
                                <field name="state" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
